# Copy to a private env file such as $HOME/.wispr/env/server.env and fill in.
WISPR_BEARER_TOKEN=replace-me
DICTATION_SERVICE_URL=https://dictation.example.com/
PORT=8090
HOST=0.0.0.0
LAN_TLS_PORT=8443
LAN_TLS_HOST=0.0.0.0
WISPR_STATE_DIR=/absolute/path/to/.wispr
LAN_TLS_KEY=/absolute/path/to/.wispr/mtls/rpc-server.key
LAN_TLS_CERT=/absolute/path/to/.wispr/mtls/rpc-server.crt
LAN_TLS_CA=/absolute/path/to/.wispr/mtls/client-ca-bundle.crt
REQUIRE_LAN_MTLS=1
WISPR_PLAYWRIGHT_CORE_PATH=/absolute/path/to/playwright-core
WISPR_PLAYWRIGHT_BROWSERS_ROOTS=/absolute/path/to/ms-playwright
