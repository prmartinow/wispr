[Unit]
Description=whisper dictation service browser (dictation service-only Chromium on :95, CDP :9223)
After=vnc-xvfb.service whisper-virtmic.service
Wants=vnc-xvfb.service whisper-virtmic.service

[Service]
Type=simple
Environment=DISPLAY=:95
# XDG_RUNTIME_DIR (/run/user/1000) is provided by the user manager -> finds the PulseAudio virtual mic.
ExecStart=/mnt/data/takeout-browser-profile/ms-playwright/chromium-1217/chrome-linux64/chrome --user-data-dir=~/whisper-service-profile --remote-debugging-port=9223 --no-first-run --no-default-browser-check --disable-dev-shm-usage --no-sandbox --use-fake-ui-for-media-stream DICTATION_SERVICE_URL/
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
