[Unit]
Description=wispr dictation service browser (dictation service-only Chromium on :95, CDP :9223)
After=vnc-xvfb.service wispr-virtmic.service
Wants=vnc-xvfb.service wispr-virtmic.service

[Service]
Type=simple
Environment=DISPLAY=:95
Environment=CHROME_DEVEL_SANDBOX=/mnt/data/takeout-browser-profile/ms-playwright/chromium-1217/chrome-linux64/chrome_sandbox
# XDG_RUNTIME_DIR (/run/user/1000) is provided by the user manager -> finds the PulseAudio virtual mic.
ExecStart=/mnt/data/takeout-browser-profile/ms-playwright/chromium-1217/chrome-linux64/chrome --user-data-dir=~/.wispr/profiles/service --remote-debugging-address=127.0.0.1 --remote-debugging-port=9223 --no-first-run --no-default-browser-check --disable-dev-shm-usage --use-fake-ui-for-media-stream about:blank
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
