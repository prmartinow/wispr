[Unit]
Description=wispr internal transcription lane %i (Chromium on :95, CDP 9223+%i, mic virtmic%i)
After=vnc-xvfb.service wispr-virtmic.service
Wants=vnc-xvfb.service wispr-virtmic.service
PartOf=wispr-virtmic.service

[Service]
Type=simple
Environment=WISPR_STATE_DIR=%h/.wispr
Environment=WISPR_PROFILE_ROOT=%h/.wispr/profiles
Environment=WISPR_LANE_PROFILE_ROOT=%h/.wispr/profiles/lanes
EnvironmentFile=-%h/.wispr/env/server.env
ExecStartPre=%h/dev/wispr/deploy/prepare-chrome-sandbox.sh
ExecStart=%h/dev/wispr/deploy/wispr-lane.sh %i
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
